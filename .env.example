# Copy to .env if you want to override defaults. QueryDoctor needs no API keys.
# Variables are read from the real environment; export them or set them in your shell.

# SQLite database the CLI and dashboard analyze
QUERYDOCTOR_DB=data/shop.db

# Dashboard bind address. Keep 127.0.0.1 unless you put authentication in front of it.
QUERYDOCTOR_HOST=127.0.0.1
QUERYDOCTOR_PORT=8000

# Where `querydoctor analyze` stores its latest report, and where `bench` writes results
QUERYDOCTOR_REPORT=.querydoctor/last_report.json
QUERYDOCTOR_BENCH_JSON=docs/benchmarks.json
QUERYDOCTOR_BENCH_MD=docs/benchmarks.md
